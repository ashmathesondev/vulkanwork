{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "vcpkg-base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "vs2022-msvc-debug",
            "displayName": "Visual Studio 2022 MSVC Debug",
            "inherits": "vcpkg-base",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build",
            "architecture": "x64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-cl-base",
            "hidden": true,
            "inherits": "vcpkg-base",
            "description": "Ninja + clang-cl. Needs ninja and clang-cl on PATH (LLVM install or the VS 'C++ Clang Compiler for Windows' component). Does not need the VS ClangCL MSBuild toolset.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/preset-${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl"
            }
        },
        {
            "name": "clang-cl-debug",
            "displayName": "Clang (clang-cl + Ninja) Debug",
            "inherits": "clang-cl-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-cl-release",
            "displayName": "Clang (clang-cl + Ninja) Release",
            "inherits": "clang-cl-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "vs2026-clangcl",
            "displayName": "Visual Studio 2026 + ClangCL toolset",
            "description": "Requires the VS component 'MSBuild support for LLVM (clang-cl) toolset' (Microsoft.VisualStudio.Component.VC.Llvm.ClangToolset). Without it, configure fails with MSB8020.",
            "inherits": "vcpkg-base",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/build/preset-${presetName}",
            "architecture": "x64",
            "toolset": "ClangCL,host=x64"
        }
    ],
    "buildPresets": [
        {
            "name": "vs2022-msvc-debug",
            "displayName": "Visual Studio 2022 MSVC Debug",
            "configurePreset": "vs2022-msvc-debug",
            "configuration": "Debug"
        },
        {
            "name": "clang-cl-debug",
            "displayName": "Clang (clang-cl + Ninja) Debug",
            "configurePreset": "clang-cl-debug"
        },
        {
            "name": "clang-cl-release",
            "displayName": "Clang (clang-cl + Ninja) Release",
            "configurePreset": "clang-cl-release"
        },
        {
            "name": "vs2026-clangcl-debug",
            "displayName": "Visual Studio 2026 + ClangCL toolset Debug",
            "configurePreset": "vs2026-clangcl",
            "configuration": "Debug"
        },
        {
            "name": "vs2026-clangcl-release",
            "displayName": "Visual Studio 2026 + ClangCL toolset Release",
            "configurePreset": "vs2026-clangcl",
            "configuration": "Release"
        }
    ]
}
