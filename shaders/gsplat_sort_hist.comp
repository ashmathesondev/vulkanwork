#version 450

// =============================================================================
// Gaussian Splat Radix Sort — Histogram pass
// =============================================================================
// Each workgroup processes ceil(N/numWG) keys.
// Counts the frequency of each 8-bit digit (byte at position 'shift') for the
// keys in the ping buffer (A if ping==0, B if ping==1).
// Writes per-workgroup histogram to histogramBuffer at [digit * numWG + wgID].

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform FrameUBO {
    mat4 view; mat4 proj; mat4 invProj;
    vec3 cameraPos; uint lightCount;
    vec3 ambientColor; uint tileCountX; uint tileCountY;
    uint screenWidth; uint screenHeight;
} frame;  // unused but required by layout

layout(std430, set = 1, binding = 0) readonly buffer SplatBuffer   { float splatData[]; };
layout(std430, set = 1, binding = 1) readonly buffer PreprocBuffer { float preprocData[]; };
layout(std430, set = 1, binding = 2) readonly buffer KeysA { uint keysA[]; };
layout(std430, set = 1, binding = 3) readonly buffer KeysB { uint keysB[]; };
layout(std430, set = 1, binding = 4) readonly buffer ValsA { uint valsA[]; };
layout(std430, set = 1, binding = 5) readonly buffer ValsB { uint valsB[]; };
layout(std430, set = 1, binding = 6) buffer HistogramBuffer { uint histogram[]; };
layout(std430, set = 1, binding = 7) buffer PrefixBuffer    { uint prefix[]; };

layout(push_constant) uniform PC {
    uint N;
    uint shift;
    uint ping;    // 0 = read keysA, 1 = read keysB
    uint numWG;
} push;

shared uint sHist[256];

void main()
{
    uint lid   = gl_LocalInvocationID.x;
    uint wgID  = gl_WorkGroupID.x;
    uint numWG = push.numWG;
    uint N     = push.N;

    // Initialise shared histogram
    sHist[lid] = 0u;
    barrier();

    // Each workgroup covers a contiguous chunk of the key array
    uint chunkSize = (N + numWG - 1u) / numWG;
    uint start     = wgID * chunkSize;
    uint end       = min(start + chunkSize, N);

    for (uint i = start + lid; i < end; i += 256u) {
        uint key   = (push.ping == 0u) ? keysA[i] : keysB[i];
        uint digit = (key >> push.shift) & 0xFFu;
        atomicAdd(sHist[digit], 1u);
    }
    barrier();

    // Write per-workgroup histogram row to global buffer
    // Layout: histogram[digit * numWG + wgID]
    histogram[lid * numWG + wgID] = sHist[lid];
}
