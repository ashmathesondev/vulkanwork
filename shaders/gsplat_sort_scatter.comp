#version 450

// =============================================================================
// Gaussian Splat Radix Sort — Scatter pass
// =============================================================================
// Each workgroup processes the same chunk it handled in the histogram pass.
// For each element, computes its global output position using the prefix table
// and scatters keys+values to the output (ping) buffer. The scatter is stable
// (see main), which LSD radix sort requires.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform FrameUBO {
    mat4 view; mat4 proj; mat4 invProj;
    vec3 cameraPos; uint lightCount;
    vec3 ambientColor; uint tileCountX; uint tileCountY;
    uint screenWidth; uint screenHeight;
} frame;

layout(std430, set = 1, binding = 0) readonly buffer SplatBuffer   { float splatData[]; };
layout(std430, set = 1, binding = 1) readonly buffer PreprocBuffer { float preprocData[]; };
layout(std430, set = 1, binding = 2) buffer KeysA { uint keysA[]; };
layout(std430, set = 1, binding = 3) buffer KeysB { uint keysB[]; };
layout(std430, set = 1, binding = 4) buffer ValsA { uint valsA[]; };
layout(std430, set = 1, binding = 5) buffer ValsB { uint valsB[]; };
layout(std430, set = 1, binding = 6) readonly buffer HistogramBuffer { uint histogram[]; };
layout(std430, set = 1, binding = 7) buffer PrefixBuffer { uint prefix[]; };

layout(push_constant) uniform PC {
    uint N;
    uint shift;
    uint ping;    // 0 = read A, write B;  1 = read B, write A
    uint numWG;
} push;

// LSD radix sort is only correct if every pass is STABLE: elements with the
// same digit must keep their relative order from the previous pass. Racing
// threads on atomicAdd would scramble that order, so each 256-element tile
// ranks its elements deterministically in shared memory instead.
shared uint sDigit[256];      // digit of each element in the current tile
shared uint sOffset[256];     // next output slot per digit for this workgroup
shared uint sTileCount[256];  // per-digit element count in the current tile

const uint INVALID_DIGIT = 0xFFFFFFFFu;

void main()
{
    uint lid   = gl_LocalInvocationID.x;
    uint wgID  = gl_WorkGroupID.x;
    uint N     = push.N;
    uint numWG = push.numWG;

    uint chunkSize = (N + numWG - 1u) / numWG;
    uint start     = wgID * chunkSize;
    uint end       = min(start + chunkSize, N);

    // Thread `lid` doubles as the owner of digit `lid` for bookkeeping.
    sOffset[lid]    = prefix[lid * numWG + wgID];
    sTileCount[lid] = 0u;
    barrier();

    for (uint tileStart = start; tileStart < end; tileStart += 256u) {
        uint i     = tileStart + lid;
        bool valid = i < end;

        uint key = 0u, val = 0u, digit = INVALID_DIGIT;
        if (valid) {
            key   = (push.ping == 0u) ? keysA[i] : keysB[i];
            val   = (push.ping == 0u) ? valsA[i] : valsB[i];
            digit = (key >> push.shift) & 0xFFu;
        }
        sDigit[lid] = digit;
        barrier();

        if (valid) {
            // Rank = number of earlier elements in this tile with the same
            // digit. Deterministic, so the scatter preserves input order.
            uint rank = 0u;
            for (uint j = 0u; j < lid; ++j)
                rank += (sDigit[j] == digit) ? 1u : 0u;

            uint outPos = sOffset[digit] + rank;
            if (push.ping == 0u) {
                keysB[outPos] = key;
                valsB[outPos] = val;
            } else {
                keysA[outPos] = key;
                valsA[outPos] = val;
            }
            atomicAdd(sTileCount[digit], 1u);  // order-independent count
        }
        barrier();

        // Advance each digit's base past this tile's elements.
        sOffset[lid]   += sTileCount[lid];
        sTileCount[lid] = 0u;
        barrier();
    }
}
