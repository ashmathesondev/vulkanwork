{
  "name": "vulkanwork",
  "version": "0.1.0",
  "dependencies": [
    "vulkan-headers",
    {
      "name": "vulkan-loader",
      "platform": "!android"
    },
    {
      "name": "glfw3",
      "platform": "!android"
    },
    "glm",
    {
      "name": "imgui",
      "features": ["glfw-binding", "vulkan-binding"],
      "platform": "!android"
    },
    {
      "name": "imgui",
      "features": ["android-binding", "vulkan-binding"],
      "platform": "android"
    },
    "stb",
    "lz4",
    "tinygltf",
    "imguizmo",
    "nlohmann-json"
  ]
}
